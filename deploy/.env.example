# labdeck configuration – copy to .env and fill in the values.
# Never commit .env: it contains secrets.
#
# Everything else – integrations, their credentials, thresholds, dashboard,
# notifications – is configured in the web interface.

# --- Deployment (read by Docker Compose) -----------------------------------

# Image version to run (without "v"). Pinned on purpose – no "latest".
# Available versions: https://github.com/mrcdlm/labdeck/releases
LABDECK_VERSION=0.3.0

# Host port for the web interface (default 8080)
# LABDECK_PORT=8080

# Time zone for log timestamps (default UTC)
# TZ=Europe/Berlin

# --- Required --------------------------------------------------------------

# Password for the web interface (plain text or bcrypt hash, max. 72 bytes)
APP_PASSWORD=change-me-to-a-long-random-password

# Key that encrypts the credentials of integrations in the database
# (AES-256-GCM). 32 bytes, Base64. Create one with:
#   openssl rand -base64 32
# Keep it safe: without it, stored credentials cannot be decrypted.
LABDECK_SECRET_KEY=replace-with-output-of-openssl-rand-base64-32

# --- Integration secrets (optional) ----------------------------------------
# Instead of entering a credential in the web interface, you can reference an
# environment variable there as ${SECRET_NAME}. Only variables with the
# prefix SECRET_ can be referenced.
# SECRET_IMMICH_API_KEY=your-immich-api-key

# --- Webhook secrets (optional) --------------------------------------------
# Webhooks store their secret encrypted in the token field (${TOKEN}). As an
# alternative they can reference variables with the prefix WEBHOOK_.
# WEBHOOK_NTFY_TOKEN=tk_…

# --- Reverse proxy (optional) ----------------------------------------------
# Reverse proxy / Cloudflare Tunnel in front of labdeck: its IP or network (CIDR).
# Only then are CF-Connecting-IP / X-Forwarded-For used as the client address
# (login rate limit, logs). Docker networks are usually within 172.16.0.0/12.
# TRUSTED_PROXIES=172.16.0.0/12

# --- Advanced (optional) ---------------------------------------------------
# LOG_LEVEL=info          # debug | info | warn | error
# PORT=8080               # port inside the container
# DATA_DIR=/data          # database directory inside the container
